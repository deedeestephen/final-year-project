@startuml api-map
' Generated by docs/report/tools/report.py (step diagrams) from docs/access-matrix.md and 2-api-gateway/openapi/ai-contract.yaml. Do not edit.
!include ../style.iuml
allowmixing
set separator none
hide circle
hide empty methods
left to right direction
skinparam ranksep 90
title The REST API: 75 routes under /api/v1, who may call them, and the AI service's internal API
actor "Phone app\n(patients, clinicians,\npathologists)" as phone
actor "Admin website\n(administrators)" as admin
class "Sign-in and sessions" as g0 <<7 routes>> {
  {field} POST /auth/change-password  ·  any signed-in account  ·  Patient, Clinician, Pathologist, Admin
  {field} POST /auth/forgot-password  ·  public  ·  anyone
  {field} POST /auth/login  ·  public  ·  anyone
  {field} POST /auth/logout  ·  any signed-in account  ·  Patient, Clinician, Pathologist, Admin
  {field} POST /auth/refresh  ·  public  ·  anyone
  {field} POST /auth/register  ·  public  ·  anyone
  {field} POST /auth/reset-password  ·  public  ·  anyone
}
phone --> g0
admin --> g0
class "Accounts" as g1 <<7 routes>> {
  {field} GET /users  ·  user:manage  ·  Admin
  {field} POST /users  ·  role:manage + user:manage  ·  Admin
  {field} DELETE /users/:id  ·  user:manage  ·  Admin
  {field} GET /users/:id  ·  user:manage  ·  Admin
  {field} PATCH /users/:id  ·  user:manage  ·  Admin
  {field} POST /users/:id/reset-password  ·  user:manage  ·  Admin
  {field} GET /users/me  ·  any signed-in account  ·  Patient, Clinician, Pathologist, Admin
}
phone --> g1
admin --> g1
class "Administration" as g2 <<12 routes>> {
  {field} GET /admin/activity  ·  audit:read  ·  Admin
  {field} GET /admin/audit-logs  ·  audit:read  ·  Admin
  {field} GET /admin/audit-logs/verify  ·  audit:read  ·  Admin
  {field} GET /admin/facilities  ·  user:manage  ·  Admin
  {field} GET /admin/patient-accounts  ·  patient_account:link  ·  Admin
  {field} POST /admin/patient-accounts/:userId/link  ·  patient_account:link  ·  Admin
  {field} POST /admin/patient-accounts/:userId/match  ·  patient_account:link  ·  Admin
  {field} POST /admin/patient-accounts/:userId/unlink  ·  patient_account:link  ·  Admin
  {field} GET /admin/permissions  ·  user:manage  ·  Admin
  {field} GET /admin/roles  ·  user:manage  ·  Admin
  {field} PUT /admin/roles/:name/permissions  ·  role:manage  ·  Admin
  {field} POST /admin/roles/:name/reset  ·  role:manage  ·  Admin
}
admin --> g2
class "Patients, screenings and consent" as g3 <<20 routes>> {
  {field} GET /clinical-records/:id  ·  clinical:read  ·  Clinician, Pathologist
  {field} GET /patients  ·  patient:read  ·  Clinician, Pathologist
  {field} POST /patients  ·  patient:create  ·  Clinician
  {field} GET /patients/:id  ·  patient:read  ·  Clinician, Pathologist
  {field} PATCH /patients/:id  ·  patient:update  ·  Clinician
  {field} GET /patients/:id/ai-jobs  ·  ai:read  ·  Clinician, Pathologist
  {field} POST /patients/:id/ai-jobs  ·  ai:request  ·  Clinician, Pathologist
  {field} GET /patients/:id/clinical-records  ·  clinical:read  ·  Clinician, Pathologist
  {field} POST /patients/:id/clinical-records  ·  clinical:create  ·  Clinician
  {field} GET /patients/:id/consents  ·  consent:manage  ·  Clinician
  {field} POST /patients/:id/consents  ·  consent:manage  ·  Clinician
  {field} POST /patients/:id/consents/:consentId/withdraw  ·  consent:manage  ·  Clinician
  {field} GET /patients/:id/histopathology  ·  histopathology:read  ·  Clinician, Pathologist
  {field} POST /patients/:id/histopathology  ·  histopathology:submit  ·  Pathologist
  {field} GET /patients/:id/imaging  ·  imaging:read  ·  Clinician, Pathologist
  {field} POST /patients/:id/imaging  ·  imaging:upload  ·  Clinician, Pathologist
  {field} GET /patients/me  ·  patient:read_self  ·  Patient
  {field} GET /patients/me/clinical-records  ·  clinical:read_self  ·  Patient
  {field} GET /patients/me/consents  ·  consent:read_self  ·  Patient
  {field} POST /patients/me/consents/:consentId/withdraw  ·  consent:withdraw_self  ·  Patient
}
phone --> g3
class "Offline synchronisation" as g4 <<2 routes>> {
  {field} POST /sync  ·  sync:write  ·  Clinician, Pathologist
  {field} GET /sync/changes  ·  clinical:read + patient:read  ·  Clinician, Pathologist
}
phone --> g4
class "Scans and slides" as g5 <<6 routes>> {
  {field} GET /histopathology/:id  ·  histopathology:read  ·  Clinician, Pathologist
  {field} GET /histopathology/:id/content  ·  histopathology:read  ·  Clinician, Pathologist
  {field} POST /histopathology/:id/review  ·  histopathology:review  ·  Pathologist
  {field} GET /histopathology/review-queue  ·  histopathology:review  ·  Pathologist
  {field} GET /imaging/:id  ·  imaging:read  ·  Clinician, Pathologist
  {field} GET /imaging/:id/content  ·  imaging:read  ·  Clinician, Pathologist
}
phone --> g5
class "AI analyses" as g6 <<6 routes>> {
  {field} GET /ai-jobs  ·  ai:read  ·  Clinician, Pathologist
  {field} GET /ai-jobs/:id  ·  ai:read  ·  Clinician, Pathologist
  {field} GET /ai-jobs/:id/explanations  ·  ai:read  ·  Clinician, Pathologist
  {field} GET /ai/models  ·  ai:models:read  ·  Clinician, Pathologist, Admin
  {field} GET /ai/models/:id/evaluation  ·  ai:models:read  ·  Clinician, Pathologist, Admin
  {field} GET /explanations/:id/content  ·  ai:read  ·  Clinician, Pathologist
}
phone --> g6
admin --> g6
class "The assistant (chat)" as g7 <<5 routes>> {
  {field} GET /chat/conversations  ·  chatbot:use  ·  Patient, Clinician
  {field} POST /chat/conversations  ·  chatbot:use  ·  Patient, Clinician
  {field} DELETE /chat/conversations/:id  ·  chatbot:use  ·  Patient, Clinician
  {field} GET /chat/conversations/:id  ·  chatbot:use  ·  Patient, Clinician
  {field} POST /chat/conversations/:id/messages  ·  chatbot:use  ·  Patient, Clinician
}
phone --> g7
class "Notifications" as g8 <<5 routes>> {
  {field} GET /notifications  ·  notification:read  ·  Patient, Clinician, Pathologist, Admin
  {field} POST /notifications/:id/read  ·  notification:read  ·  Patient, Clinician, Pathologist, Admin
  {field} POST /notifications/devices  ·  notification:read  ·  Patient, Clinician, Pathologist, Admin
  {field} DELETE /notifications/devices/:id  ·  notification:read  ·  Patient, Clinician, Pathologist, Admin
  {field} POST /notifications/read-all  ·  notification:read  ·  Patient, Clinician, Pathologist, Admin
}
phone --> g8
admin --> g8
class "FHIR export" as g9 <<3 routes>> {
  {field} POST /fhir/export  ·  fhir:export  ·  Admin
  {field} POST /fhir/export/push  ·  fhir:export  ·  Admin
  {field} GET /fhir/export/summary  ·  fhir:export  ·  Admin
}
admin --> g9
class "Health" as g10 <<2 routes>> {
  {field} GET /health  ·  public  ·  anyone
  {field} GET /health/ready  ·  public  ·  anyone
}
phone --> g10
admin --> g10
class "AI service (internal; service token)" as aisvc <<FastAPI>> {
  {field} GET /v1/health
  {field} GET /v1/models
  {field} POST /v1/infer
  {field} POST /v1/chat/answer
}
g6 --> aisvc : /v1/infer
g7 --> aisvc : /v1/chat/answer
entity "SmartCare Pro\n(FHIR R4, HTTPS)" as smartcare #f1f5f9
g9 --> smartcare : push
legend right
  Each line: method, path, permission, roles that have it by default.
  An arrow means the app's users have permission for at least one route in the group.
  Every route except the public ones needs a valid access token.
  Administrators can change role permissions (within locks).
endlegend
@enduml
