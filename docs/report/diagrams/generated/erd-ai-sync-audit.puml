@startuml erd-ai-sync-audit
' Generated by docs/report/tools/report.py (step diagrams) from 3-application-logic/backend/prisma/schema.prisma. Do not edit.
!include ../style.iuml
set separator none
hide circle
hide empty methods
skinparam linetype ortho
title PostgreSQL: AI jobs, notifications, synchronisation and the audit log
entity "ai_models" as ai_models #f5f3ff {
  * id : uuid <<PK>>
  --
  * name : text
  * architecture : ModelArchitecture
  * version : text
  * provenance : ModelProvenance
  * status : ModelStatus
    artifact_uri : text
    evaluation : jsonb
  * created_at : timestamptz
}
entity "ai_jobs" as ai_jobs #f5f3ff {
  * id : uuid <<PK>>
  --
  * patient_id : uuid <<FK>>
  * requested_by_id : uuid
  * status : AiJobStatus
  * inputs : jsonb
    model_versions : jsonb
    report_id : text
    input_notes : jsonb
    error : text
    started_at : timestamptz
    finished_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
}
entity "explainability_artifacts" as explainability_artifacts #f5f3ff {
  * id : uuid <<PK>>
  --
  * job_id : uuid <<FK>>
    model_id : uuid <<FK>>
  * kind : ExplanationKind
    storage_key : text
    unavailable_reason : text
  * created_at : timestamptz
}
entity "notifications" as notifications #fff7ed {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * type : text
  * title : text
  * body : text
    read_at : timestamptz
  * created_at : timestamptz
    pushed_at : timestamptz
}
entity "push_devices" as push_devices #fff7ed {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * token : text <<UQ>>
  * platform : text
  * created_at : timestamptz
  * last_seen_at : timestamptz
}
entity "sync_operations" as sync_operations #fff7ed {
  * id : uuid <<PK>>
  --
  * idempotency_key : text <<UQ>>
  * user_id : uuid
  * device_id : text
  * entity_type : text
    entity_id : uuid
  * operation : SyncOperationType
    base_version : integer
    resulting_version : integer
  * result : SyncResult
    conflict_detail : jsonb
  * client_timestamp : timestamptz
  * received_at : timestamptz
}
entity "audit_logs" as audit_logs #fff7ed {
  * seq : bigint <<PK>>
  --
  * occurred_at : timestamptz
    actor_user_id : uuid
    actor_role : text
  * action : text
  * entity_type : text
    entity_id : text
  * outcome : AuditOutcome
    request_id : text
    ip : text
    details : jsonb
  * prev_hash : text
  * row_hash : text
}
entity "users" as users #f1f5f9 {
  * id : uuid <<PK>>
}
entity "patients" as patients #f1f5f9 {
  * id : uuid <<PK>>
}
ai_jobs }o--|| patients : patient_id
explainability_artifacts }o--|| ai_jobs : job_id
explainability_artifacts }o--o| ai_models : model_id
notifications }o--|| users : user_id
push_devices }o--|| users : user_id
enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}
enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}
enum ExplanationKind {
  GRADCAM
  SHAP
  MIL_ATTENTION
}
enum ModelArchitecture {
  UNET
  RESNET50
  ANN
  PATCH_CNN_MIL
  XGBOOST_FUSION
}
enum ModelProvenance {
  MOCK
  RESEARCH_MODEL
}
enum ModelStatus {
  REGISTERED
  ACTIVE
  RETIRED
}
enum SyncOperationType {
  CREATE
  UPDATE
}
enum SyncResult {
  APPLIED
  CONFLICT
  REJECTED
}
note bottom of explainability_artifacts
Either a stored artifact or an explicit reason it is
unavailable (NFR-09).
end note
note bottom of push_devices
A phone that receives push notifications (ADR-014). The
token is Firebase Cloud Messaging's address for one install
of the app. It is removed when the user signs out, when FCM
says it is no longer valid, and with the account.
end note
note bottom of sync_operations
One row per client operation. idempotency_key makes retries
safe (UC-02).
end note
note bottom of audit_logs
Append-only (UPDATE/DELETE blocked by trigger). Each row
stores the previous row's hash; seq, prev_hash and row_hash
are assigned by a BEFORE INSERT trigger.
end note
legend right
  * required (NOT NULL)   PK primary key   FK foreign key   UQ unique
endlegend
@enduml
