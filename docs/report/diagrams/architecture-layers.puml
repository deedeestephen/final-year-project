@startuml architecture-layers
!include style.iuml
title The six-layer architecture as built (research proposal §3.3)
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 45

package "1  Presentation" as L1 {
  component "Phone app\nFlutter 3.35 (Android)\nRiverpod, go_router\nDrift + SQLCipher (offline)\nphone speech and read-aloud" as app
  component "Admin website\nReact 19 + Vite\n(accounts, roles, audit,\nFHIR export, dashboard)" as web
}

package "2  API gateway" as L2 {
  component "Reverse proxy (nginx)\nTLS 1.3 only, HSTS\n(deployment; checked\nby tls-check.sh)" as proxy
  component "NestJS gateway\nthrottling, JWT (Ed25519),\nper-account limit, permissions,\nvalidation, OpenAPI 3, /api/v1" as gw
}

package "3  Application logic (NestJS 11, TypeScript)" as L3 {
  component "Auth, users,\nadmin, activity" as s1
  component "Patients, clinical\nrecords, consent" as s2
  component "Sync\n(idempotent batches)" as s3
  component "Imaging and\nhistopathology" as s4
  component "AI broker\nand job queue" as s5
  component "Chatbot\n(safety, small talk)" as s6
  component "FHIR R4 export" as s7
  component "Notifications,\naudit (hash chain)" as s8
}

package "4  AI intelligence (Python 3, FastAPI)" as L4 {
  component "Model router and providers\n(U-Net, ResNet-50, ANN,\npatch-CNN MIL, XGBoost fusion)\ntoday: labelled MOCK" as router
  component "Explainers\n(Grad-CAM, SHAP, MIL attention)\nor the reason there is none" as explain
  component "Chat answers from the reviewed\nknowledge base: BM25 keywords,\nMedCPT meaning (numpy);\noptional Claude writer (off)" as chat
}

package "5  Data persistence" as L5 {
  database "PostgreSQL 18\n20 tables, CHECKs,\nappend-only audit chain" as pg
  database "MongoDB 8.3\n4 collections\nwith validators" as mongo
  storage "Object storage\nlocal folder\n(S3 / MinIO option)" as files
  database "Redis\nrate-limit counters" as redis
  storage "Knowledge base\n(reviewed JSON)" as kb
  storage "Meaning index\n(passage vectors, file)\nand MedCPT models" as vec
  database "Vector store\n(memory; Qdrant ready\nfor a larger knowledge base)" as qvec
}

package "6  Infrastructure" as L6 {
  component "Docker Compose\nRedis, MinIO, Qdrant" as compose
  component "dev-up.ps1 / dev-down.ps1\nphone-usb.ps1" as scripts
  component "Quality gate +\nGitHub Actions CI" as gate
}

app --> gw : HTTPS + JSON
web --> gw : HTTPS + JSON\n(HttpOnly cookie)
proxy ..> gw : in deployment
gw --> s1
gw --> s2
gw --> s3
gw --> s4
gw --> s5
gw --> s6
gw --> s7
s5 --> router : HTTP + service token
s6 --> chat : HTTP + service token
router --> explain
chat --> kb
chat --> vec
s1 --> pg
s2 --> pg
s3 --> pg
s4 --> files
s5 --> mongo
s6 --> mongo
s8 --> pg
gw --> redis
L6 -[hidden]up- L5
@enduml
