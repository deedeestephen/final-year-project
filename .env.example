# Copy to .env and replace every placeholder. Never commit .env.

# --- Backend ---
NODE_ENV=development
PORT=3000
# Admin web app (Vite dev server). Add the real admin URL in production.
CORS_ORIGINS=http://localhost:5173

# Rate limits per minute: per network address, and per signed-in account.
RATE_LIMIT_MAX=600
USER_RATE_LIMIT_MAX=120

# --- PostgreSQL ---
POSTGRES_USER=pca
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pca_mhealth
# Host port for the project Postgres (5432 is often taken by a locally installed PostgreSQL service)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pca:change-me@localhost:5433/pca_mhealth?schema=public

# --- MongoDB ---
MONGO_USER=pca
MONGO_PASSWORD=change-me
# Host port for the project Mongo (27017 is often taken by a locally installed MongoDB service)
MONGO_PORT=27018
MONGO_URL=mongodb://pca:change-me@localhost:27018/pca_mhealth?authSource=admin

# --- Redis (optional in dev; in-memory rate limiting is used when unset) ---
REDIS_PASSWORD=change-me
# e.g. redis://:<REDIS_PASSWORD>@localhost:6379/0 (shared rate limits across API instances)
REDIS_URL=

# --- Object storage for imaging and slides (S3 API / MinIO) ---
# local = files under 3-application-logic/backend/var/objects (git-ignored); s3 = MinIO or any S3 store.
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=var/objects
# Largest accepted upload, in MB.
MAX_IMAGING_MB=512
MAX_SLIDE_MB=2048
MINIO_ROOT_USER=pcaminio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pca-mhealth
S3_ACCESS_KEY=pcaminio
S3_SECRET_KEY=change-me-min-8-chars

# --- Auth (generate with: node 6-infrastructure/scripts/gen-keys.mjs) ---
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=pca-mhealth
JWT_AUDIENCE=pca-mhealth-app
# 32-byte base64 key for column-level encryption of direct identifiers
FIELD_ENCRYPTION_KEY_BASE64=
# 32-byte base64 key for keyed hashes (searchable national ID without storing it in clear)
FIELD_HMAC_KEY_BASE64=

# --- AI services ---
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=change-me
# Chatbot answers written by Claude from the reviewed passages (ADR-010).
# Leave the key empty for free quoted answers only (ADR-009). The key is a secret:
# it stays in the git-ignored .env, never in the repository.
ANTHROPIC_API_KEY=
CHAT_LLM_MODEL=claude-haiku-4-5-20251001
CHAT_LLM_DAILY_LIMIT=2000
# How long (milliseconds) the backend waits for one analysis; analyses run at once.
AI_TIMEOUT_MS=30000
AI_MAX_CONCURRENT_JOBS=2

# --- FHIR export to SmartCare Pro (Phase 14) ---
# Empty = sending is off (downloads still work). For the local mock
# ("npm run smartcare:mock"): http://localhost:8090/fhir. https in production.
SMARTCARE_FHIR_URL=
# Bearer token for SmartCare Pro (the mock checks it too when set).
SMARTCARE_TOKEN=
SMARTCARE_TIMEOUT_MS=30000
# Largest number of patients in one export (larger: export one facility at a time).
FHIR_EXPORT_MAX_PATIENTS=5000

# Vector store for the chatbot: memory | qdrant
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
# Optional, costs money. Leave empty to use the offline extractive fallback.
LLM_API_KEY=

# Password for SYNTHETIC demo accounts created by 'npm run db:seed'. Leave empty to generate one and print it once.
SEED_DEMO_PASSWORD=
