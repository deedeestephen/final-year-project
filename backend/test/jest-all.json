{
  "rootDir": "..",
  "projects": [
    "<rootDir>",
    "<rootDir>/test/jest-e2e.json",
    "<rootDir>/test/jest-db.json"
  ],
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/main.ts",
    "!src/**/*.module.ts",
    "!src/infrastructure/mongo/migrate.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage",
  "coverageReporters": [
    "text",
    "text-summary",
    "json-summary",
    "lcovonly"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  }
}
