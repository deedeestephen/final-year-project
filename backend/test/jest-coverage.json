{
  "rootDir": "..",
  "projects": [
    "<rootDir>",
    "<rootDir>/test/jest-e2e.json"
  ],
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/main.ts",
    "!src/**/*.module.ts",
    "!src/infrastructure/mongo/**",
    "!src/infrastructure/storage/s3-object-storage.ts",
    "!src/infrastructure/vector/qdrant-vector-store.ts",
    "!src/infrastructure/database/prisma.service.ts",
    "!src/infrastructure/database/mongo.service.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage",
  "coverageReporters": [
    "text",
    "text-summary",
    "json-summary",
    "lcovonly"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  }
}
