{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/db/.*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/test/db/global-setup.ts",
  "globalTeardown": "<rootDir>/test/db/global-teardown.ts",
  "setupFiles": [
    "<rootDir>/test/db/setup-env.ts"
  ],
  "testTimeout": 60000
}
